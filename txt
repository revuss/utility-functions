const filteredObj = Object.entries(obj)
  .filter(
    ([key, value]) =>
      key !== "invoiceId" &&
      key !== "serviceName" &&
      key !== "customerAdhaar" &&
      key !== "total" &&
      key !== "0|invoiceCreatedAt" &&
      key !== "0|invoiceId" &&
      key !== "0|serviceName" &&
      key !== "3-customerAdhaar" &&
      key !== "Total" &&
      key !== "invoiceCreatedAt" &&
      key !== "custConvFee" &&
      value !== null && // Exclude null values
      value !== undefined && // Exclude undefined values
      value !== "" // Exclude empty strings
  )
  .sort(([keyA], [keyB]) => keyA.localeCompare(keyB));
