<tbody>
  <tr className="bg-white">
    {chunk.map(([key, value]) => (
      <td
        key={key}
        className="border-2 px-2 py-2 text-left text-[10px] font-normal"
      >
        {(key.includes("amount") || key.includes("billAmount")) &&
        (serviceKey === "DMT_MONEY_TRANSFER" || serviceKey === "BBPS_BILL_PAY")
